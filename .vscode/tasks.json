{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Import assets",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Import"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Godot: Open editor",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Editor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Godot: Play Schedule 1 Chess prototype",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Run"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Godot: Test interface",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Test"
      ],
      "problemMatcher": []
    },
    {
      "type": "process",
      "label": "Godot: Verify everything",
      "group": {
        "isDefault": true,
        "kind": "test"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Verify"
      ],
      "problemMatcher": [],
      "command": "powershell.exe"
    },
    {
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "Rules"
      ],
      "problemMatcher": [],
      "command": "powershell.exe",
      "type": "process",
      "label": "Godot: Test rules"
    },
    {
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/godot.ps1",
        "NetworkTest"
      ],
      "problemMatcher": [],
      "command": "powershell.exe",
      "type": "process",
      "label": "Godot: Test multiplayer"
    }
  ]
}
