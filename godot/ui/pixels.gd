static func motif(id: String) -> String:
	if PATTERNS.has(id): return id
	if id in ["magic","glass","royalguard","vest","sanctuary","service"]: return "shield"
	if id in ["greed","collector","lotto","potgold","heist","treasure","grave","insurance"]: return "coin"
	if id in ["speed","wrath","dolphin","lager","chaos","pacify","rabid"]: return "bottle"
	if id in ["barrett","lewis","grenade","glock","m4","missile","flare","jet","helicopter","membership","amendment","pawn","halo"]: return "gun"
	if id in ["rat","wizard","agent","cia"]: return "hat"
	if id in ["boots","combatboots","retreat","chacha","eject"]: return "boot"
	if id in ["doom","spider","wendigo","counterspawn","spore","fungus"]: return "skull"
	if id in ["sapling","celestial","robotic","grass"]: return "tree"
	if id in ["shipping","skyhook","ticket","gale"]: return "wing"
	if id in ["hidden","pack","scissors","dnd","blanket","radio","lasso"]: return "card"
	return "star"

static func texture(id: String, side: int = -1) -> Texture2D:
	var cache_key = id+":"+str(side)
	if cache.has(cache_key): return cache[cache_key]
	if side==-1 and id in CourtCardArt.IDS:
		var illustration=CourtCardArt.texture(id)
		cache[cache_key]=illustration
		return illustration
	var pattern = PATTERNS[motif(id)]
	var image = Image.create(20,20,false,Image.FORMAT_RGBA8)
	var fill = CourtPalette.PAPER if side==0 else (Color("b5a4d5") if side==1 else Color("f2c86c"))
	if side == -1:
		var colors = [Color("f2c86c"),Color("ed8f81"),Color("80d4bf"),Color("c9a8ef")]
		fill = colors[absi(id.hash())%colors.size()]
		if id=="mystery": fill=Color("e5dfcf")
	var outline = Color("25202f")
	for y in range(16):
		for x in range(16):
			if pattern[y][x] == "#":
				for delta in [Vector2i(-1,0),Vector2i(1,0),Vector2i(0,-1),Vector2i(0,1),Vector2i(0,2)]:
					image.set_pixel(x+2+delta.x,y+1+delta.y,outline)
	for y in range(16):
		for x in range(16):
			if pattern[y][x] == "#":
				var color = fill.lightened(0.12) if y<5 else (fill.darkened(0.23) if x>10 or y>11 else fill)
				image.set_pixel(x+2,y+1,color)
	# Interior pixel details give objects their own identity rather than font glyphs.
	if motif(id)=="knight": image.set_pixel(8,5,outline)
	if motif(id)=="coin":
		for y in range(5,11): image.set_pixel(9,y,fill.darkened(0.45))
	if motif(id)=="shield":
		for y in range(4,11): image.set_pixel(9,y,fill.lightened(0.4))
	var result = ImageTexture.create_from_image(image)
	cache[cache_key] = result
	return result
